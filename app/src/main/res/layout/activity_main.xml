<?xml version="1.0" encoding="utf-8"?>
<!-- Visual test "verde mate": full-bleed bike photo hero, today's numbers as tiles, two pill
     shortcuts, everything else under "Más", and the Connect/Disconnect pill pinned at the bottom.
     Every id the code uses is kept. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero: the active bike's Garage photo, edge to edge. -->
            <FrameLayout
                android:id="@+id/hero_card"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:background="@color/bg">

                <ImageView
                    android:id="@+id/hero_placeholder"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:alpha="0.18"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ride"
                    app:tint="@color/text_secondary" />

                <ImageView
                    android:id="@+id/hero_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_gravity="top"
                    android:background="@drawable/bg_hero_scrim_top" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_hero_scrim" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="@font/archivo_black"
                        android:text="//"
                        android:textColor="@color/brand_gold"
                        android:textSize="22sp"
                        tools:ignore="HardcodedText" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/brand_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/archivo_black"
                            android:text="@string/brand_wordmark"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.04"
                            android:text="@string/brand_tagline"
                            android:textColor="#CCF1F4EC"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/brand_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            tools:text="v2.0.18" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_lang"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_round_glass"
                        android:contentDescription="@string/main_lang_desc"
                        android:fontFamily="@font/archivo_black"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        tools:text="TH" />

                    <ImageButton
                        android:id="@+id/btn_hero_menu"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_round_glass"
                        android:contentDescription="@string/main_settings_desc"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="34dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/hero_brand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/archivo_black"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.06"
                        android:maxLines="1"
                        android:shadowColor="#99000000"
                        android:shadowDy="2"
                        android:shadowRadius="8"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        tools:text="ZONTES" />

                    <TextView
                        android:id="@+id/hero_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/archivo_black"
                        android:maxLines="1"
                        android:paddingEnd="12dp"
                        android:shadowColor="#99000000"
                        android:shadowDy="2"
                        android:shadowRadius="8"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_primary"
                        android:textSize="56sp"
                        tools:text="125X" />

                    <TextView
                        android:id="@+id/hero_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:letterSpacing="0.06"
                        android:maxLines="1"
                        android:textColor="#E6F1F4EC"
                        android:textSize="14sp"
                        tools:text="ZT473788" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="-6dp"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp">

                <!-- v2.2 home (proposal A): status + today's numbers in one card. -->
                <LinearLayout
                    android:id="@+id/status_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_card"
                    android:elevation="10dp"
                    android:outlineAmbientShadowColor="@color/brand_gold"
                    android:outlineSpotShadowColor="@color/brand_gold"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/status_icon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@string/main_connection_status"
                            android:src="@drawable/ic_status_dot" />

                        <TextView
                            android:id="@+id/status_view"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/archivo_semibold"
                            android:text="@string/main_ready"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp" />

                        <ImageButton
                            android:id="@+id/btn_status_bt"
                            android:layout_width="48dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_bt_button"
                            android:contentDescription="@string/home_bt_settings"
                            android:padding="11dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_bluetooth"
                            app:tint="@color/text_primary" />

                        <ProgressBar
                            android:id="@+id/status_progress"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:indeterminateTint="@color/brand_orange"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/bike_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="26dp"
                        android:layout_marginTop="2dp"
                        android:text="@string/main_no_bike_paired_yet"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_line_top"
                        android:baselineAligned="false"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:paddingTop="14dp">

                        <!-- v2.3: live speed while projecting (replaces "km/h máx"). -->
                        <LinearLayout
                            android:id="@+id/stat_speed_box"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.3"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:baselineAligned="true"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/stat_speed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/archivo_black"
                                    android:includeFontPadding="false"
                                    android:text="--"
                                    android:textColor="@color/brand_gold"
                                    android:textSize="44sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="km/h"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <TextView
                                style="@style/HeroStatLabel"
                                android:text="@string/stat_speed_now" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView style="@style/HeroStatIcon" android:src="@drawable/ic_tile_route" />

                            <LinearLayout style="@style/HeroStatRow">
                                <TextView
                                    android:id="@+id/stat_km"
                                    style="@style/HeroStatValue"
                                    android:text="--" />
                                <TextView style="@style/HeroStatUnit" android:text="km" tools:ignore="HardcodedText" />
                            </LinearLayout>

                            <TextView
                                style="@style/HeroStatLabel"
                                android:text="@string/home_stat_dist" />
                        </LinearLayout>

                        <View style="@style/HeroStatDivider" />

                        <LinearLayout
                            android:id="@+id/stat_max_box"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView style="@style/HeroStatIcon" android:src="@drawable/ic_speed" />

                            <LinearLayout style="@style/HeroStatRow">
                                <TextView
                                    android:id="@+id/stat_max"
                                    style="@style/HeroStatValue"
                                    android:text="--" />
                                <TextView style="@style/HeroStatUnit" android:text="km/h" tools:ignore="HardcodedText" />
                            </LinearLayout>

                            <TextView
                                style="@style/HeroStatLabel"
                                android:text="@string/home_stat_max" />
                        </LinearLayout>

                        <View style="@style/HeroStatDivider" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView style="@style/HeroStatIcon" android:src="@drawable/ic_tile_timer" />

                            <TextView
                                android:id="@+id/stat_clock"
                                style="@style/HeroStatValue"
                                android:text="--" />

                            <TextView
                                android:id="@+id/stat_clock_label"
                                style="@style/HeroStatLabel"
                                android:text="@string/stat_clock" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- v2.3: battery + lock card from the keyless box (read only); only once the PKE code is set. -->
                <LinearLayout
                    android:id="@+id/pke_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_stat_tile"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/HeroStatLabel"
                            android:text="@string/pke_card_title" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:baselineAligned="true"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/pke_volts"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/archivo_black"
                                android:includeFontPadding="false"
                                android:text="--"
                                android:textColor="@color/text_primary"
                                android:textSize="30sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="V"
                                android:textColor="@color/text_secondary"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/pke_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/pke_lock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/archivo_semibold"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Android Auto's head unit server isn't running (RideScreen AA v2). -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/hus_banner"
                    style="@style/Card.OpenCfMoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:strokeColor="@color/status_busy">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hus_title"
                            android:textColor="@color/status_busy"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/hus_body"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/hus_open"
                                style="@style/Widget.OpenCfMoto.Button.Connect"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:text="@string/hus_open" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/hus_how"
                                style="@style/Widget.OpenCfMoto.Segment"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:text="@string/hus_how" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Connected: what you use while riding. Tiles are filled in by MainActivity.setupHomeTiles(). -->
                <LinearLayout
                    android:id="@+id/live_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout android:id="@+id/btn_park_photo" style="@style/HomeTile.Big" android:layout_marginEnd="5dp" />
                        <LinearLayout android:id="@+id/btn_controls" style="@style/HomeTile.Big" android:layout_marginStart="5dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout android:id="@+id/btn_hud_view" style="@style/HomeTile.Big" android:layout_marginEnd="5dp" />
                        <LinearLayout android:id="@+id/btn_trip" style="@style/HomeTile.Big" android:layout_marginStart="5dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/et_destination"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/main_search_a_place_or_address"
                            android:imeOptions="actionGo"
                            android:inputType="textPostalAddress"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_navigate"
                            style="@style/Widget.OpenCfMoto.Segment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/main_go" />
                    </LinearLayout>

                    <!-- v2.3: one-tap destinations (home, work, upcoming calendar events with a place). -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/quick_dest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Parked: where the bike is, with the photo (RideScreen AA v2.2 card). -->
                <LinearLayout
                    android:id="@+id/btn_parked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_stat_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/parked_thumb"
                        android:layout_width="96dp"
                        android:layout_height="84dp"
                        android:background="@color/surface_high"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/parked_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/archivo_semibold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/parked_sub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/parked_walk"
                                style="@style/Widget.OpenCfMoto.Segment"
                                android:background="@drawable/bg_connect_gold"
                                android:textColor="@color/on_brand"
                                app:backgroundTint="@null"
                                app:icon="@drawable/ic_nav_arrow"
                                app:iconSize="16dp"
                                app:iconTint="@color/on_brand"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:minWidth="0dp"
                                android:paddingHorizontal="12dp"
                                android:text="@string/parked_walk"
                                android:textSize="13sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/parked_view_photo"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:textColor="@color/text_primary"
                                app:cornerRadius="20dp"
                                app:icon="@drawable/ic_tile_camera"
                                app:iconSize="16dp"
                                app:iconTint="@color/brand_gold"
                                app:strokeColor="@color/brand_gold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:paddingHorizontal="12dp"
                                android:text="@string/home_view_photo"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Six shortcuts, each with a live detail line (both states). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/btn_trips_list" style="@style/HomeTile" android:layout_marginEnd="5dp" />
                    <LinearLayout android:id="@+id/btn_fuel" style="@style/HomeTile" android:layout_marginHorizontal="5dp" />
                    <LinearLayout android:id="@+id/btn_maint" style="@style/HomeTile" android:layout_marginStart="5dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/btn_traffic_lights" style="@style/HomeTile" android:layout_marginEnd="5dp" />
                    <LinearLayout android:id="@+id/btn_live" style="@style/HomeTile" android:layout_marginHorizontal="5dp" />
                    <LinearLayout android:id="@+id/btn_help" style="@style/HomeTile" android:layout_marginStart="5dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/more_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="22dp"
                    android:drawableStart="@drawable/bg_section_bar"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/archivo_semibold"
                    android:gravity="center_vertical"
                    android:text="@string/main_more"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <!-- Home navigation menu: wide shortcuts that scroll sideways, a light runs round the panel. -->
                <FrameLayout
                    android:id="@+id/home_nav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_nav_panel"
                    android:padding="8dp">

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fadingEdgeLength="24dp"
                        android:requiresFadingEdge="horizontal"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_gpx" style="@style/HomeMore" android:background="@drawable/bg_more_item_active" android:text="@string/gpx_map" app:iconTint="@color/brand_gold" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_dash_screen" style="@style/HomeMore" android:text="@string/dl_more" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_dashcam" style="@style/HomeMore" android:text="@string/dvr_menu" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_mirror_start" style="@style/HomeMore" android:text="@string/main_mirror" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_aa_start" style="@style/HomeMore" android:text="@string/main_scan" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_devices" style="@style/HomeMore" android:text="@string/garage_garage" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_controls_more" style="@style/HomeMore" android:text="@string/controls_controls" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_setup" style="@style/HomeMore" android:text="@string/home_settings_short" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_more_about" style="@style/HomeMore" android:text="@string/home_nav_about" app:icon="@drawable/ic_info" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </FrameLayout>

                <!-- Hidden since v2.2 (kept for code refs): Stop merged into Connect; logs/tips live in Help. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_aa_stop"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="@string/main_stop"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_toggle_log"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="@string/main_logs"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tips_panel"
                    style="@style/Card.OpenCfMoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="@string/main_rider_tips"
                            android:textAllCaps="true"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/main_connect_start_android_auto_on_the_dash_becomes_s"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_about_page"
                            style="@style/Widget.OpenCfMoto.Segment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/main_about_credits" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_check_update"
                            style="@style/Widget.OpenCfMoto.Segment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/main_check_for_update" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_problem_report"
                            style="@style/Widget.OpenCfMoto.Segment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/main_report_a_problem" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_donate"
                            style="@style/Widget.OpenCfMoto.Button.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/support_button"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/log_panel"
                    style="@style/Card.OpenCfMoto.Log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="220dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:letterSpacing="0.08"
                                android:text="@string/main_diagnostics"
                                android:textAllCaps="true"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_share_log"
                                style="@style/Widget.OpenCfMoto.Button.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:text="@string/main_share" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_clear"
                                style="@style/Widget.OpenCfMoto.Button.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:text="@string/main_clear" />
                        </LinearLayout>

                        <ScrollView
                            android:id="@+id/log_scroll"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:layout_marginTop="4dp"
                            android:background="@color/bg"
                            android:fillViewport="true"
                            android:nestedScrollingEnabled="true"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/log_view"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/main_logs"
                                android:fontFamily="monospace"
                                android:textColor="#9CDCFE"
                                android:textIsSelectable="true"
                                android:textSize="11sp" />
                        </ScrollView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Connect becomes Disconnect while linking or projecting. Pinned like a thumb button, on the
         carbon + gold-line backdrop from the brand mockup (its glow lines frame the button). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/home_bottom" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_connect"
            style="@style/Widget.OpenCfMoto.Button.Connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="34dp"
            android:elevation="14dp"
            android:outlineAmbientShadowColor="@color/brand_gold"
            android:outlineSpotShadowColor="@color/brand_gold"
            android:text="@string/main_connect" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="54dp"
            android:layout_marginBottom="10dp"
            android:elevation="16dp"
            android:fontFamily="@font/archivo_black"
            android:importantForAccessibility="no"
            android:text="»"
            android:textColor="@color/on_brand"
            android:textSize="30sp"
            tools:ignore="HardcodedText" />
    </FrameLayout>
</LinearLayout>
