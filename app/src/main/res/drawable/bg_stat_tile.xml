<?xml version="1.0" encoding="utf-8"?>
<!-- Luxury card: gold gradient rim (bright top-left, faint middle), dark glass fill, glow line at the bottom. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="315" android:startColor="#B3FFD24A" android:centerColor="#1FF5B80C" android:endColor="#8CF5B80C" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape>
            <gradient android:angle="300" android:startColor="#FF1F1F24" android:centerColor="#FF141417" android:endColor="#FF0C0C0E" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="bottom" android:left="36dp" android:right="36dp">
        <shape>
            <gradient android:angle="0" android:startColor="#00FFD84A" android:centerColor="#FFFFD84A" android:endColor="#00FFD84A" />
        </shape>
    </item>
</layer-list>
