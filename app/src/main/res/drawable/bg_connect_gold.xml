<?xml version="1.0" encoding="utf-8"?>
<!-- Connect CTA: bright glossy yellow-gold pill with a sheen across the top half. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape>
                    <gradient android:angle="270" android:startColor="#FFFFDA4D" android:centerColor="#FFF5B80C" android:endColor="#FFD69400" />
                    <stroke android:width="1.5dp" android:color="#FFFFF0A8" />
                    <corners android:radius="34dp" />
                </shape>
            </item>
            <item android:bottom="32dp" android:left="20dp" android:right="20dp" android:top="3dp">
                <shape>
                    <gradient android:angle="270" android:startColor="#73FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="30dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
